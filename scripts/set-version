#!/usr/bin/env bash
# Writes one version into every file that carries it, then regenerates the API contract (its info.version comes from
# the service). Prints the files it changed.
#   scripts/set-version 1.2.0
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
version="${1:-}"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "usage: scripts/set-version 1.2.0" >&2; exit 2; }
cd "$root"
python3 - "$version" <<'PY'
import re, sys
version = sys.argv[1]
# (file, pattern whose group 1 is kept and group 2 is the version, how many matches are expected)
edits = [
    ("apps/desktop/package.json", r'(\n  "version": ")([^"]+)', 1),
    ("packages/contracts/package.json", r'(\n  "version": ")([^"]+)', 1),
    ("apps/desktop/src-tauri/tauri.conf.json", r'(\n  "version": ")([^"]+)', 1),
    ("apps/desktop/src-tauri/Cargo.toml", r'(\[package\]\nname = "amsg-desktop"\nversion = ")([^"]+)', 1),
    ("apps/desktop/src-tauri/Cargo.lock", r'(name = "amsg-desktop"\nversion = ")([^"]+)', 1),
    ("services/api/pyproject.toml", r'(\[project\]\nname = "amsg-service"\nversion = ")([^"]+)', 1),
    ("services/api/uv.lock", r'(name = "amsg-service"\nversion = ")([^"]+)', 1),
    ("services/api/src/amsg/__init__.py", r'(__version__ = ")([^"]+)', 1),
    ("integrations/hermes/amsg_plugin/plugin.yaml", r'(\nversion: )(\S+)', 1),
]
for path, pattern, expected in edits:
    text = open(path).read()
    new, count = re.subn(pattern, lambda m: m.group(1) + version, text)
    if count != expected:
        sys.exit(f"{path}: expected {expected} version field, found {count}. Update scripts/set-version.")
    if new != text:
        open(path, "w").write(new)
        print(path)
PY
scripts/generate-contracts >/dev/null
git diff --name-only -- packages/contracts
