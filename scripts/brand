#!/usr/bin/env bash
# Rebuilds the logo from design/logo/source and copies it into the desktop app:
#   design/logo/{symbol,app-icon}/*.svg              masters
#   apps/desktop/src/components/logo.gen.ts          symbol paths for the Logo component
#   apps/desktop/public/assets/branding/favicon.svg   browser favicon
#   apps/desktop/src-tauri/icons/*                    app icons, from design/logo/app-icon/amsg-app-icon-colour.svg
# Needs uv and the desktop dependencies (pnpm install). Run: scripts/brand
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
cd "$root"

echo "== Logo masters and logo.gen.ts"
uv run --quiet --no-project --python 3.13 python - <<'PY'
import json, os, sys
sys.path.insert(0, 'design/logo/source')
import build  # writes design/logo/{symbol,app-icon}
out = 'apps/desktop/src/components/logo.gen.ts'
with open(out, 'w') as f:
    f.write('// Generated by scripts/brand from design/logo/source/build.py. Do not edit.\n')
    f.write('// The a-msg symbol on a 256 x 256 canvas; draw with fill-rule="evenodd".\n')
    f.write(f'export const LOGO = {json.dumps(build.SYM)}\n')
    f.write('// Heavier cut for 32 px and below.\n')
    f.write(f'export const LOGO_SMALL = {json.dumps(build.SYM_SMALL)}\n')
print('wrote', out)
PY

echo "== Static branding"
branding=apps/desktop/public/assets/branding
mkdir -p "$branding"
cp design/logo/symbol/amsg-symbol-small-colour.svg "$branding/favicon.svg"
echo "wrote $branding"

echo "== App icons"
# tauri icon also writes Android, iOS and Windows Store sets; keep only the files tauri.conf.json uses.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
if ! (cd apps/desktop && pnpm exec tauri icon ../../design/logo/app-icon/amsg-app-icon-colour.svg -o "$tmp/out") >"$tmp/log" 2>&1; then
  cat "$tmp/log" >&2
  exit 1
fi
icons=apps/desktop/src-tauri/icons
for file in 32x32.png 64x64.png 128x128.png 128x128@2x.png icon.icns icon.ico icon.png; do
  cp "$tmp/out/$file" "$icons/$file"
done
echo "wrote $icons"
