#!/usr/bin/env bash
# Builds the self-contained service for this platform and smoke-tests the result.
# No Python is needed to run it. Build on each target: artifacts do not cross platforms.
#   scripts/build-service [--archive]
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$HOME/.local/bin:$PATH"
cd "$root/services/api"
uv sync --quiet --frozen
out="$root/build/service"
rm -rf "$out"
uv run --quiet --frozen pyinstaller --noconfirm --clean --onedir --name amsg \
  --distpath "$out" --workpath "$root/build/pyinstaller" --specpath "$root/build" \
  --add-data "$root/services/api/migrations:migrations" \
  --collect-submodules amsg --collect-submodules uvicorn \
  --hidden-import sqlalchemy.dialects.sqlite \
  --paths src entry.py >/dev/null
binary="$out/amsg/amsg"
# The browser interface, served when browser access is on (amsg web). Same build as the desktop app's. A host
# without Node (a runner-only Raspberry Pi, say) builds the service alone.
web=0
if command -v pnpm >/dev/null && [[ -d "$root/node_modules" ]]; then
  (cd "$root/apps/desktop" && pnpm exec vite build --logLevel error)
  cp -R "$root/apps/desktop/dist" "$out/amsg/web"
  web=1
else
  echo "pnpm or node_modules missing: building without the browser interface" >&2
fi
data="$(mktemp -d)"
trap 'rm -rf "$data"; [[ -n "${server:-}" ]] && kill "$server" 2>/dev/null || true' EXIT
"$binary" --version
port=18795
AMSG_DATA_DIR="$data" "$binary" serve --port "$port" >/dev/null 2>&1 &
server=$!
for _ in $(seq 1 100); do curl -sf "http://127.0.0.1:$port/health/live" >/dev/null && break; sleep 0.1; done
curl -sf "http://127.0.0.1:$port/health/live" >/dev/null
AMSG_DATA_DIR="$data" "$binary" pair --data-dir "$data" >/dev/null 2>&1
if [[ $web == 1 ]]; then
  # Browser access: the packaged interface is found beside the executable and served with its policy.
  kill "$server"; wait "$server" 2>/dev/null || true
  AMSG_DATA_DIR="$data" AMSG_WEB_ORIGIN="http://127.0.0.1:$port" "$binary" serve --port "$port" >/dev/null 2>&1 &
  server=$!
  for _ in $(seq 1 100); do curl -sf "http://127.0.0.1:$port/health/live" >/dev/null && break; sleep 0.1; done
  curl -sfI "http://127.0.0.1:$port/" | grep -qi '^content-security-policy:'
  curl -sf "http://127.0.0.1:$port/v1/web/session" >/dev/null
fi
echo "smoke test passed: $binary"
if [[ "${1:-}" == "--archive" ]]; then
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"; arch="$(uname -m)"
  version="$("$binary" --version)"
  name="amsg-service-$version-$os-$arch"
  stage="$root/build/$name"
  rm -rf "$stage"; mkdir -p "$stage"
  cp -R "$out/amsg" "$stage/service"
  cp "$root/packaging/linux/install.sh" "$root/packaging/linux/uninstall.sh" "$root/packaging/linux/install-runner.sh" "$stage/"
  cp -RL "$root/integrations/hermes/amsg_plugin" "$stage/hermes-plugin"
  find "$stage/hermes-plugin" -name __pycache__ -type d -prune -exec rm -rf {} +
  mkdir -p "$root/release"
  tar -czf "$root/release/$name.tar.gz" -C "$root/build" "$name"
  if command -v sha256sum >/dev/null; then hash=(sha256sum); else hash=(shasum -a 256); fi
  (cd "$root/release" && "${hash[@]}" "$name.tar.gz" > "$name.tar.gz.sha256")
  echo "$root/release/$name.tar.gz"
fi
